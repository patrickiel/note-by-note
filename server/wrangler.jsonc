{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "note-by-note-sync",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "SYNC_KV",
			"id": "53d23d1799a74bbca74ec8b98fa98b51",
			"remote": true
		}
	],
	// Per-IP cap on writes (PUT/DELETE). A real client pushes on a 5 s debounce
	// and pulls every 5 min, so this is far above normal use and only bites
	// scripted abuse. `namespace_id` is a per-Worker label, not an account
	// resource — self-hosters can leave it as-is.
	"ratelimits": [
		{
			"name": "SYNC_WRITE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	]
}